---
import type { WorkMode } from '../data/routes';
const {mode,slug=''}=Astro.props as {mode:WorkMode;slug?:string};
const isPayroll=slug==='salary-slip-generator'||slug.endsWith('/1099-contractor-invoice-generator');
---
<div class="fields">
{mode==='upi-qr'&&<><label>Business name<input data-key="business" autocomplete="organization" /></label><label>UPI ID<input data-key="vpa" /></label><div class="amount-row"><label>Amount (₹)<input data-key="amount" type="number" min="1" step="0.01" /></label><label>Invoice reference<input data-key="reference" /></label></div><label>Payment note<input data-key="note" /></label><div class="pills" aria-label="Bank UPI handles">{['@okaxis','@okicici','@okhdfcbank','@ybl','@paytm'].map(x=><button type="button" class="pill" data-handle={x}>{x}</button>)}</div><label class="check"><input data-key="openAmount" type="checkbox" /> Let the payer enter an amount</label></>}
{mode==='payment-qr'&&<><label>Business name<input data-key="business" autocomplete="organization" /></label><label>Payment link<input data-key="paymentUrl" type="url" placeholder="https://paypal.me/yourname/amount" /></label><div class="amount-row"><label>Invoice amount (USD)<input data-key="invoiceAmount" type="number" min="0" step="0.01" /></label><label>Invoice reference<input data-key="reference" /></label></div><label>Payment note<input data-key="note" /></label><p class="tax-mode" data-link-status>Enter a Stripe, PayPal, Venmo, Square or Wise HTTPS payment link.</p></>}
{mode==='gst-invoice'&&<><div class="amount-row"><label>Supplier / seller<input data-key="seller" /></label><label>Invoice number<input data-key="invoice" /></label></div><label>Document type<select data-key="documentType"><option>Tax Invoice</option><option>Quotation</option><option>Proforma Invoice</option><option>Bill of Supply</option><option>Retail Bill</option><option>Purchase Order</option><option>Delivery Challan</option><option>Credit / Debit Note</option></select></label><label>Seller GSTIN<input data-key="sellerGstin" maxlength="15" /></label><label>Buyer / customer<input data-key="buyer" /></label><label>Buyer GSTIN<input data-key="buyerGstin" maxlength="15" /></label><label>UPI ID for payment<input data-key="vpa" /></label><p class="tax-mode" data-tax-mode>Enter both GSTINs to calculate tax type.</p><label>Line items <small>One per line: Description | HSN/SAC | Qty | Rate ₹ | GST %</small><textarea data-key="items" rows="5"></textarea></label></>}
{mode==='hra-rent'&&<><div class="amount-row"><label>Tenant name<input data-key="tenant" /></label><label>Landlord name<input data-key="landlord" /></label></div><div class="amount-row"><label>Monthly rent (₹)<input data-key="rent" type="number" /></label><label>Landlord PAN<input data-key="pan" /></label></div><label>Rental property address<input data-key="address" /></label><div class="amount-row"><label>Start month<input data-key="start" type="month" /></label><label>End month<input data-key="end" type="month" /></label></div><label>Payment mode<select data-key="payment"><option>UPI</option><option>Bank transfer</option><option>Cash</option><option>Cheque</option></select></label><p class="tax-mode" data-pan-warning>Landlord PAN is required when annual rent exceeds ₹1,00,000.</p></>}
{mode==='us-customs-b2b'&&<><label>Exporter<input data-key="exporter" /></label><label>Consignee<input data-key="consignee" /></label><div class="amount-row"><label>Carrier<input data-key="carrier" /></label><label>Incoterm<select data-key="incoterm"><option>DDP</option><option>DAP</option><option>FOB</option><option>EXW</option></select></label></div><label>Weight unit<select data-key="weightUnit"><option>kg</option><option>lbs</option></select></label><label>Shipment items<small>Description | HS tariff | Country of origin | Qty | Unit price USD | Net weight | Gross weight</small><textarea data-key="items" rows="5"></textarea></label><label>Package dimensions<input data-key="dimensions" placeholder="e.g. 3 cartons · 40 × 30 × 25 cm" /></label></>}
{mode==='late-fee'&&<><label>Customer<input data-key="customer" /></label><label>Invoice reference<input data-key="invoice" /></label><div class="amount-row"><label>Past-due amount (USD)<input data-key="principal" type="number" min="0" step="0.01" /></label><label>Annual late-fee rate (%)<input data-key="annualRate" type="number" min="0" step="0.01" /></label></div><label>Days overdue<input data-key="daysLate" type="number" min="0" step="1" /></label><p class="tax-mode" data-late-fee-note>Simple interest, prorated by overdue days.</p></>}
{mode==='hr-docs'&&isPayroll&&<><div class="amount-row"><label>Employee / contractor<input data-key="employee" /></label><label>Company / client<input data-key="company" /></label></div><label>Pay period<input data-key="period" /></label><div class="amount-row"><label>Basic / services<input data-key="basic" type="number" /></label><label>HRA<input data-key="hra" type="number" /></label></div><div class="amount-row"><label>Allowance<input data-key="allowance" type="number" /></label><label>Deductions / withholding<input data-key="deductions" type="number" /></label></div><label>Payment QR URL (optional)<input data-key="paymentUrl" type="url" placeholder="https://paypal.me/…" /></label></>}
{mode==='hr-docs'&&!isPayroll&&<><label>Business / issuer<input data-key="company" /></label><label>Customer / recipient<input data-key="employee" /></label><label>Document reference or period<input data-key="period" /></label><div class="amount-row"><label>Amount ({slug.startsWith('us/')?'USD':'₹'})<input data-key="amount" type="number" min="0" step="0.01" /></label><label>Line description<input data-key="allowance" /></label></div><label>Payment QR URL (optional)<input data-key="paymentUrl" type="url" placeholder="https://paypal.me/…" /></label></>}
</div>
