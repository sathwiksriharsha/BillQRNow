---
import SiteLayout from '../layouts/SiteLayout.astro';
const { page } = Astro.props;
const copy:Record<string,string[]>={
about:['BillQRNow makes everyday billing and workplace paperwork easier to prepare. The tools are designed for independent businesses, employees and teams that need clean documents without a complicated setup.','Your forms are processed in your browser. BillQRNow does not need an account or a copy of your financial information to create a PDF.'],
contact:['For feedback or support, email hello@billqrnow.pages.dev. Include the tool name and a short description of the issue; please do not include bank credentials, full payment details or sensitive identity documents.'],
privacy:['BillQRNow generators process form entries locally in your browser. The site does not transmit invoice, rent, salary, tax, payment-link or shipment details to an application server.','Generated files are created on your device. Browser clipboard access is used only when you choose to copy a payment link. You can clear entered values by refreshing the page.','The static site may be hosted by a content delivery provider, which can process standard technical request data such as IP address and browser information under its own policies.'],
terms:['BillQRNow provides editable document-generation utilities for convenience. You are responsible for checking calculations, identifiers, legal language and the suitability of each document before relying on it.','The tools do not provide tax, legal, accounting or customs advice and do not guarantee acceptance by an authority, bank, employer or carrier. Use the latest rules and obtain professional advice where needed.'],
'all-tools':['Choose a tool below to prepare a payment QR, invoice, receipt, salary document or international shipping record. Every generator includes a sample so you can see its output before entering your own details.']};
---
<SiteLayout title={page.title} description={page.description} path={`/${page.slug}`}><main class="content-page"><span class="eyebrow">BillQRNow</span><h1>{page.slug==='all-tools'?'All tools':page.slug==='about'?'Paperwork made simpler':'Information for using BillQRNow'}</h1>{(copy[page.slug]||[]).map(p=><p>{p}</p>)}{page.slug==='all-tools'&&<div class="tool-directory">{Astro.props.routes.map((r:any)=><a href={`/${r.slug}`}><span>{r.headline}</span><b>↗</b></a>)}</div>}</main></SiteLayout>
