---
import SiteLayout from '../layouts/SiteLayout.astro';
import { routes } from '../data/routes';

const quick = [
  ['upi-qr-code-generator', 'UPI QR generator'],
  ['gst-invoice-generator', 'GST invoice generator'],
  ['hra-rent-receipt-generator', 'HRA rent receipts'],
  ['salary-slip-generator', 'Salary slip generator'],
  ['us/commercial-invoice-generator', 'US commercial invoice'],
  ['us/packing-list-generator', 'Packing list generator'],
];

const toolGroups = [
  {
    title: 'India billing & payments',
    image: '/billqrnow-counter.webp',
    alt: 'A small Indian shopkeeper preparing a customer payment request at the counter',
    links: [
      ['upi-qr-code-generator', 'Dynamic UPI payment QR'],
      ['gst-invoice-generator', 'GST tax invoice'],
      ['quotation-maker-online', 'Quotation and estimate'],
    ],
  },
  {
    title: 'People & workplace',
    image: '/billqrnow-hr-desk.webp',
    alt: 'Rent receipts and workplace documents arranged on a desk',
    links: [
      ['hra-rent-receipt-generator', 'HRA rent receipts'],
      ['salary-slip-generator', 'Salary slip'],
      ['experience-certificate-format-generator', 'Experience certificate'],
    ],
  },
  {
    title: 'US & global trade',
    image: '/billqrnow-shipping-desk.webp',
    alt: 'A parcel and shipping paperwork ready for an international shipment',
    links: [
      ['us/commercial-invoice-generator', 'Commercial invoice'],
      ['us/packing-list-generator', 'Packing list'],
      ['us/1099-contractor-invoice-generator', '1099 contractor invoice'],
    ],
  },
];
---

<SiteLayout title="Free Invoice, UPI QR & Receipt Tools — Private & No Commission (Free, No Login) | BillQRNow" description="Create amount-locked UPI QR codes, GST invoices, rent receipts, salary slips and customs PDFs. Free, private tools that run in your browser." path="/">
  <main>
    <section class="quick-switch" aria-labelledby="popular-tools-title">
      <h2 id="popular-tools-title">Popular document tools</h2>
      <nav aria-label="Popular tools">
        {quick.map(([slug, label]) => (
          <a href={`/${slug}`}><span>{label}</span><b aria-hidden="true">↗</b></a>
        ))}
      </nav>
    </section>

    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-copy">
        <h1 id="home-title">Billing paperwork,<br />without the busywork.</h1>
        <p>Create clear invoices, payment QR codes and receipts in your browser. No account, no commission, and no upload of your financial details.</p>
        <a class="button-primary hero-button" href="/all-tools">Explore all free tools <span aria-hidden="true">↗</span></a>
      </div>

      <div class="home-visual">
        <img
          class="home-counter-photo"
          src="/billqrnow-counter.webp"
          alt="A neighborhood shopkeeper preparing a payment request and invoice at the counter"
          width="1200"
          height="800"
          fetchpriority="high"
        />
        <div class="photo-label"><span class="photo-label-dot"></span> Made for everyday business</div>
        <article class="home-document" data-ui aria-label="Example payment request">
          <div class="doc-head"><span>PAYMENT REQUEST</span><b>INV-2026-402</b></div>
          <div class="doc-rule"></div>
          <div class="doc-row"><span>Design services</span><b>₹ 4,350.00</b></div>
          <div class="doc-rule"></div>
          <div class="doc-total"><span>Amount due</span><strong>₹ 4,350.00</strong></div>
          <div class="doc-lock"><span aria-hidden="true">₹</span><div><b>Amount fixed</b><small>Ready to share with your customer</small></div></div>
        </article>
      </div>
    </section>

    <section class="home-library" aria-labelledby="tool-groups-title">
      <div class="library-intro">
        <h2 id="tool-groups-title">Useful tools for everyday business.</h2>
        <p>From a customer’s first payment to an international shipment, build the documents that keep work moving.</p>
      </div>
      <div class="library-columns">
        {toolGroups.map((group) => (
          <article class="library-card">
            <img src={group.image} alt={group.alt} width="1200" height="800" loading="lazy" decoding="async" />
            <div class="library-card-copy">
              <h3>{group.title}</h3>
              {group.links.map(([slug, label]) => (
                <a href={`/${slug}`}>{label}<span aria-hidden="true">↗</span></a>
              ))}
            </div>
          </article>
        ))}
      </div>
      <a class="text-link" href="/all-tools">Browse all {routes.length} document tools <span aria-hidden="true">→</span></a>
    </section>
  </main>
</SiteLayout>
