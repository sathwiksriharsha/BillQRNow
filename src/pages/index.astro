---
import SiteLayout from '../layouts/SiteLayout.astro';
import { routes } from '../data/routes';
const quick=[['upi-qr-code-generator','UPI QR generator'],['gst-invoice-generator','GST invoice generator'],['hra-rent-receipt-generator','HRA rent receipts'],['salary-slip-generator','Salary slip generator'],['us/commercial-invoice-generator','US commercial invoice'],['us/packing-list-generator','Packing list generator']];
---
<SiteLayout title="Free Invoice, UPI QR & Receipt Tools — Private & No Commission (Free, No Login) | BillQRNow" description="Create amount-locked UPI QR codes, GST invoices, rent receipts, salary slips and customs PDFs. Free, private tools that run in your browser." path="/">
<main><section class="quick-switch"><div><span class="eyebrow">Start with a popular tool</span><h2>Choose what you need to make.</h2></div><nav aria-label="Popular tools">{quick.map(([slug,label])=><a href={`/${slug}`}><span>{label}</span><b>↗</b></a>)}</nav></section>
<section class="home-hero"><div><span class="eyebrow">Documents that stay yours</span><h1>Billing paperwork,<br/>without the busywork.</h1><p>Create clear invoices, payment QR codes and receipts in your browser. No account, no commission, and no upload of your financial details.</p><a class="button-primary hero-button" href="/all-tools">Explore all free tools <span>↗</span></a></div><div class="home-document"><div class="doc-head"><span>PAYMENT REQUEST</span><b>INV-2026-402</b></div><div class="doc-rule"></div><div class="doc-row"><span>Design services</span><b>₹ 4,350.00</b></div><div class="doc-rule"></div><div class="doc-total"><span>Amount due</span><strong>₹ 4,350.00</strong></div><div class="doc-qr">▦</div><p>Scan with any UPI app</p></div></section>
<section class="home-library"><div class="library-intro"><span class="eyebrow">One calm place for paperwork</span><h2>Useful tools for everyday business.</h2><p>From a customer’s first payment to an international shipment, build the documents that keep work moving.</p></div><div class="library-columns"><div><h3>India billing & payments</h3><a href="/upi-qr-code-generator">Dynamic UPI payment QR <span>↗</span></a><a href="/gst-invoice-generator">GST tax invoice <span>↗</span></a><a href="/quotation-maker-online">Quotation and estimate <span>↗</span></a></div><div><h3>People & workplace</h3><a href="/hra-rent-receipt-generator">HRA rent receipts <span>↗</span></a><a href="/salary-slip-generator">Salary slip <span>↗</span></a><a href="/experience-certificate-format-generator">Experience certificate <span>↗</span></a></div><div><h3>US & global trade</h3><a href="/us/commercial-invoice-generator">Commercial invoice <span>↗</span></a><a href="/us/packing-list-generator">Packing list <span>↗</span></a><a href="/us/1099-contractor-invoice-generator">1099 contractor invoice <span>↗</span></a></div></div><a class="text-link" href="/all-tools">Browse all {routes.length} document tools <span>→</span></a></section></main>
</SiteLayout>
