---
import { siteName, siteUrl } from '../config/site';
import '../styles/global.css';
const { title, description, path='/' } = Astro.props;
const canonical = `${siteUrl}${path}`;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#f6f8f4"/><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/png" sizes="128x128" href="/favicon.png"/><title>{title}</title></head><body>
<header class="site-header"><a class="wordmark" href="/" aria-label="BillQRNow home"><img class="wordmark-icon" src="/favicon.png" alt="" width="32" height="32"/>BillQRNow</a><nav><a href="/all-tools">All tools</a><a href="/about">About</a><a href="/privacy">Privacy</a><a class="nav-action" href="/upi-qr-code-generator">Create a QR</a></nav></header>
<slot />
<footer class="site-footer"><div class="footer-main"><a class="wordmark" href="/"><img class="wordmark-icon" src="/favicon.png" alt="" width="32" height="32"/>BillQRNow</a><p>Practical billing documents, created privately in your browser.</p></div><div class="footer-links"><a href="/all-tools">All tools</a><a href="/about">About</a><a href="/contact">Contact</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div><small>© 2026 BillQRNow</small></footer>
</body></html>
